# Copia este archivo a .env y ajusta lo que necesites (todo es opcional).
PORT=3000
# DB_PATH=./data/mochilas.db

# Base de datos COMPARTIDA en Turso (necesaria en Vercel para que no se pierdan sesiones, carritos ni pedidos).
# Sin estas dos variables se usa el archivo local data/mochilas.db.
# TURSO_DATABASE_URL=libsql://mochilas-aventura-mx-tuusuario.turso.io
# TURSO_AUTH_TOKEN=eyJhbGciOi...

# Correo REAL (opcional). Sin SMTP_HOST los correos se SIMULAN: se guardan en la base de datos
# y se ven en Administración → Correos.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=tu_correo@gmail.com
# SMTP_PASS=contraseña_de_aplicacion
# MAIL_FROM="Mochilas Aventura MX <contacto@mochilasaventuramx.com>"
